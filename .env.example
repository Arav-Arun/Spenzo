# Copy to .env and fill in.

# Database: any Postgres. Free on neon.tech → your project → Connect → copy the connection string.
# Then create the tables once:  uv run python scripts/setup_db.py
DATABASE_URL="postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"           # pooled: the app
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"         # direct: setup_db.py
# `neon init` / `neon env pull` fill both in for you.

# AI (chat, reading bills, voice notes)
OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4.1-mini"
# OPENAI_TRANSCRIBE_MODEL="gpt-4o-mini-transcribe"

# WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API setup)
WHATSAPP_TOKEN="EAAG..."                  # a permanent System User token
WHATSAPP_PHONE_NUMBER_ID="1234567890"
WHATSAPP_APP_SECRET="app-secret"          # proves webhooks really come from Meta
WHATSAPP_BUSINESS_ACCOUNT_ID=""        # only if whatsapp_connect.py asks for it
WHATSAPP_APP_ID="1234567890"              # App settings → Basic; used by scripts/whatsapp_connect.py
WHATSAPP_VERIFY_TOKEN="any-random-string" # you choose it; paste the same value in Meta's webhook setup
# WHATSAPP_API_VERSION="v25.0"

# Signs dashboard and AI links: any long random string, kept the same across restarts.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=""
WEB_URL="https://www.spenzo.aravarun.in"


# Local testing only. Never set in production.
# ALLOW_UNSIGNED_WEBHOOKS="1"
